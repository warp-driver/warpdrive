RUST_LOG="info,warpdrive=debug"
# For WarpDrive devs:
# RUST_LOG="info,warpdrive-tests=debug,warpdrive=debug"

# WarpDrive
# WARPDRIVE_DATA=~/warpdrive/data
# WARPDRIVE_LOG_LEVEL="info, wavs[{subsys=TriggerManager}]=debug"
WARPDRIVE_SIGNING_MNEMONIC="test test test test test test test test test test test junk"
WARPDRIVE_AGGREGATOR_COSMOS_CREDENTIAL="test test test test test test test test test test test junk"
WARPDRIVE_AGGREGATOR_EVM_CREDENTIAL="test test test test test test test test test test test junk"
# Stellar aggregator credential — funded ed25519 secret in `S...` strkey form
# (NOT a mnemonic). Pays for and signs Soroban transactions; admin of the
# deployed Warpdrive contracts. The operator/vector signing key is unrelated
# and continues to come from WARPDRIVE_SIGNING_MNEMONIC (secp256k1).
WARPDRIVE_AGGREGATOR_STELLAR_CREDENTIAL=""

# CLI
# WARPDRIVE_CLI_DATA=~/warpdrive/cli
WARPDRIVE_CLI_COSMOS_MNEMONIC="test test test test test test test test test test test junk"
WARPDRIVE_CLI_EVM_CREDENTIAL="test test test test test test test test test test test junk"
# Stellar CLI credential — BIP-39 mnemonic (raw private-key credentials are not
# supported). Used for signing `set-service-uri` on the Stellar project_root.
WARPDRIVE_CLI_STELLAR_CREDENTIAL="test test test test test test test test test test test junk"
WARPDRIVE_CLI_LOG_LEVEL="info, wavs_cli=debug"
